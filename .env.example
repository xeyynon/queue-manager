# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (use the *pooled* URL, sslmode=require)
DATABASE_URL=

# Separate Neon branch used only by `npm run test:db` (tests delete data there)
TEST_DATABASE_URL=

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Public base URL of the app (http://localhost:3000 in dev)
BETTER_AUTH_URL=http://localhost:3000

# Optional demo account (npm run seed:demo). Shown on the login page when set.
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_TZ=Asia/Kolkata
